{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stepdoc:schema:run-record:0.2",
  "title": "stepdoc run record",
  "description": "One run of one or more test cases. The procedure renders the symbolic fields, the executed report the concrete ones. Times are seconds since the test case started.",
  "type": "object",
  "required": ["schema_version", "generator", "created_at", "dry_run", "tests"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"enum": ["0.1", "0.2"], "description": "0.2 adds count, t_last, section and reads"},
    "generator": {
      "type": "object",
      "required": ["name", "version", "python"],
      "properties": {
        "name": {"const": "stepdoc"},
        "version": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "dry_run": {"type": "boolean"},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}
  },
  "$defs": {
    "status": {"enum": ["passed", "failed", "error", "not_run", "unknown"]},
    "section": {"enum": ["setup", "procedure", "teardown"], "description": "Unscoped entries only: the phase they ran in (STEP-8)"},
    "location": {
      "type": ["object", "null"],
      "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer"}}
    },
    "test": {
      "type": "object",
      "required": ["id", "procedure_id", "case", "status", "outcome", "dry_run", "params", "seed",
                   "started_at", "duration", "unscoped", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "pytest node id of the case, e.g. tests/test_api.py::test_user[ana]"},
        "procedure_id": {"type": "string", "description": "Cases with the same procedure_id share one procedure (the node id without the parameter id)"},
        "case": {"type": ["string", "null"], "description": "Parameter id, e.g. 'ana'"},
        "status": {"$ref": "#/$defs/status", "description": "Combined from the recorded steps and checks"},
        "outcome": {"type": ["string", "null"], "enum": ["passed", "failed", "error", "skipped", null], "description": "The runner's verdict (NFR-7)"},
        "dry_run": {"type": "boolean"},
        "params": {"type": "object", "description": "Parameter values of this case (PAR-1)"},
        "seed": {"description": "Random seed when a source provides one (PAR-4)"},
        "started_at": {"type": "string", "format": "date-time"},
        "duration": {"type": ["number", "null"]},
        "unscoped": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/check"}]}, "description": "Actions and checks outside any step (ACT-3); each carries the section it ran in"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}
      }
    },
    "step": {
      "type": "object",
      "required": ["type", "number", "title", "section", "status", "started", "ended", "error", "location", "entries"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "step"},
        "number": {"type": "string", "description": "1, 1.2, 1.2.3; setup steps S1, S1.1; teardown steps T1"},
        "title": {"type": "string"},
        "section": {"enum": ["setup", "procedure", "teardown"]},
        "status": {"$ref": "#/$defs/status"},
        "started": {"type": "number"},
        "ended": {"type": "number"},
        "error": {"type": ["string", "null"]},
        "location": {"$ref": "#/$defs/location"},
        "entries": {
          "type": "array",
          "description": "Actions, checks and child steps in execution order, sharing one numbering",
          "items": {"oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/check"}, {"$ref": "#/$defs/step"}]}
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "number", "op", "direction", "target", "value", "bound_to", "resolved", "location", "t", "meta"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "action"},
        "number": {"type": ["string", "null"], "description": "null for unscoped actions"},
        "op": {"type": "string", "description": "Free-form: request, read, write, query, measure, ..."},
        "direction": {"enum": ["in", "out", "exchange"], "description": "in: the test sends value; out: value is a result; exchange: value is sent, the response is in meta"},
        "target": {
          "type": "object",
          "required": ["concrete", "symbolic"],
          "properties": {
            "concrete": {"type": "string", "description": "GET /users/17"},
            "symbolic": {"type": ["string", "null"], "description": "GET /users/<user_id>"}
          }
        },
        "value": {
          "type": "object",
          "required": ["concrete", "symbolic", "expr"],
          "properties": {
            "concrete": {"description": "JSON value; non-JSON values are tagged objects with $type plus $repr, $enum or $base64"},
            "symbolic": {"type": ["string", "null"], "description": "<width>, 100, {\"name\": <name>}"},
            "expr": {"type": ["string", "null"], "description": "Source expression, null for literals"}
          }
        },
        "bound_to": {"type": ["string", "null"], "description": "Name a result was assigned to"},
        "resolved": {"type": "boolean", "description": "false when the source could not be found (SYM-5)"},
        "location": {"$ref": "#/$defs/location"},
        "t": {"type": "number"},
        "count": {"type": "integer", "minimum": 1, "description": "Identical consecutive events from one code location collapsed into this entry (ACT-4 polling)"},
        "t_last": {"type": ["number", "null"], "description": "Time of the last repeated event when count > 1"},
        "meta": {"type": "object", "description": "Bridge metadata, for example the HTTP status code"},
        "section": {"$ref": "#/$defs/section"}
      }
    },
    "check": {
      "type": "object",
      "required": ["type", "number", "text", "passed", "expected", "actual", "detail", "selected", "children", "location"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "check"},
        "number": {"type": ["string", "null"]},
        "text": {"type": "string", "description": "What is verified, e.g. the assert expression"},
        "passed": {"type": ["boolean", "null"], "description": "null: recorded, not judged (CHK-7)"},
        "expected": {},
        "actual": {},
        "detail": {"type": ["string", "null"]},
        "selected": {"type": ["string", "null"], "description": "Chosen branch of a composite check"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "reads": {"type": "array", "items": {"$ref": "#/$defs/action"}, "description": "Reads on the check's source line that fed it (ACT-5)"},
        "location": {"$ref": "#/$defs/location"},
        "section": {"$ref": "#/$defs/section"}
      }
    }
  }
}
